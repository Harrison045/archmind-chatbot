# ArchMind — Python backend / terminal chatbot config
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Your Groq API key (free) — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any model available on Groq (e.g. openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Shared Q&A cache — a Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL=your_database_connection_string_here
